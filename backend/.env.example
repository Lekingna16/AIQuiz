# ============================================
# AIQuiz Backend - Environment Variables
# Copy file này thành .env và điền giá trị thực
# ============================================

# --- Application ---
APP_NAME=AIQuiz
APP_VERSION=1.0.0
DEBUG=true

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=aiquiz

# --- AI provider ---
# Set AI_PROVIDER=gemini to use Gemini. Do not commit real keys.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- File Upload ---
MAX_FILE_SIZE_MB=50

# --- OCR (PDF scan / ảnh trong PDF, Word) ---
# Tải dữ liệu OCR: python scripts/download_tessdata.py  (→ backend/tessdata)
OCR_ENABLED=true
OCR_LANGUAGES=vie+eng
OCR_DPI=250
OCR_MAX_PAGES=24
# TESSDATA_PREFIX=E:/path/to/tessdata

# --- CORS ---
FRONTEND_URL=http://localhost:5173
