# ============================================
# AIQuiz Backend - Environment Variables
# Copy file này thành .env và điền giá trị thực
# ============================================

# --- Application ---
APP_NAME=AIQuiz
APP_VERSION=1.0.0
DEBUG=true

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=aiquiz

# --- AI provider ---
# DeepSeek handles answers and scanned pages. Do not commit real keys.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
# Optional: explicitly set AI_PROVIDER or OCR_PROVIDER to gemini to use it.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- File Upload ---
MAX_FILE_SIZE_MB=50

# --- OCR (PDF scan / ảnh trong PDF, Word) ---
# Tải dữ liệu OCR: python scripts/download_tessdata.py  (→ backend/tessdata)
OCR_ENABLED=true
OCR_LANGUAGES=vie+eng
OCR_DPI=250
OCR_MAX_PAGES=24
# TESSDATA_PREFIX=E:/path/to/tessdata
# Đọc PDF scan qua DeepSeek Vision, tối đa hai trang đồng thời.
OCR_PROVIDER=deepseek
OCR_AI_VISION=true

# --- CORS ---
FRONTEND_URL=http://localhost:5173
